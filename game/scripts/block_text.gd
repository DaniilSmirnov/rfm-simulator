# Cyrillic letters drawn exactly like Latin ones.
const SAME = {"А": "A", "В": "B", "Е": "E", "Ё": "E", "К": "K", "М": "M", "Н": "H", "О": "O", "Р": "P", "С": "C", "Т": "T", "Х": "X"}

static func glyph(character: String) -> Array:
	var key = SAME.get(character, character)
	return GLYPHS.get(key, [])

# Triangles of `text` with cells of `pixel` metres. Each row's runs of lit
# cells become one quad. Unknown characters leave a blank cell.
static func triangles(text: String, pixel: float) -> PackedVector3Array:
	var upper = text.to_upper()
	var vertices = PackedVector3Array()
	var width = float(upper.length() * 6 - 1)
	for i in range(upper.length()):
		var rows: Array = glyph(upper.substr(i, 1))
		for row in range(rows.size()):
			var line: String = rows[row]
			var col = 0
			while col < 5:
				if line.substr(col, 1) != "1":
					col += 1
					continue
				var run = col
				while run < 5 and line.substr(run, 1) == "1":
					run += 1
				var x0 = (i * 6 + col - width * 0.5) * pixel
				var x1 = (i * 6 + run - width * 0.5) * pixel
				var y = (ROWS * 0.5 - row) * pixel
				var a = Vector3(x0, y, 0)
				var b = Vector3(x1, y, 0)
				var c = Vector3(x1, y - pixel, 0)
				var d = Vector3(x0, y - pixel, 0)
				vertices.append_array(PackedVector3Array([a, b, c, a, c, d]))
				col = run
	return vertices

# Cell size that gives block letters the cap height of a Label3D.
static func label_pixel(label: Label3D) -> float:
	return float(label.font_size) * label.pixel_size / 10.0
