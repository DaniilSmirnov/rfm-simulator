{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally-fans-simulator",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/vk"
    ]
  },
  "main": "server/worker.mjs",
  "secrets": {
    "required": [
      "VK_APP_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RallyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RallyRoom"
      ]
    }
  ],
  "vars": {
    "VK_APP_ID": "54809523"
  }
}
