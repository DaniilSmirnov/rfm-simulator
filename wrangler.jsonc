{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally-fans-simulator",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/vk"
    ]
  },
  "main": "server/worker.mjs",
  "secrets": {
    "required": [
      "VK_APP_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RallyRoom"
      },
      {
        "name": "PAYMENTS",
        "class_name": "VkPayments"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RallyRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "VkPayments"
      ]
    }
  ],
  "ratelimits": [
    {"name":"API_RATE_LIMIT", "namespace_id":"5480952301", "simple":{"limit":6000,"period":60}},
    {"name":"AUTH_RATE_LIMIT", "namespace_id":"5480952302", "simple":{"limit":120,"period":60}},
    {"name":"ROOM_ENTRY_RATE_LIMIT", "namespace_id":"5480952303", "simple":{"limit":30,"period":60}},
    {"name":"STORE_RATE_LIMIT", "namespace_id":"5480952304", "simple":{"limit":120,"period":60}},
    {"name":"PURCHASE_RATE_LIMIT", "namespace_id":"5480952305", "simple":{"limit":12,"period":60}}
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "RATE_LIMIT_ENABLED": "true",
    "VK_APP_ID": "54809523",
    "VK_PAYMENTS_MODE": "production"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
