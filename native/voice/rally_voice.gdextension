windows.x86_64 = "res://native/voice/bin/rally_voice.windows.x86_64.dll"
macos.arm64 = "res://native/voice/bin/librally_voice.macos.arm64.dylib"
macos.x86_64 = "res://native/voice/bin/librally_voice.macos.x86_64.dylib"
